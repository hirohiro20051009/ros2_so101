<?xml version="1.0" encoding="UTF-8"?>
<robot name="so101_new_calib">
    <group name="arm">
        <chain base_link="base_link" tip_link="gripper_frame_link"/>
    </group>
    <group name="hand">
        <joint name="gripper"/>
    </group>
    <group_state name="center" group="arm">
        <joint name="elbow_flex" value="0"/>
        <joint name="shoulder_lift" value="0"/>
        <joint name="shoulder_pan" value="0"/>
        <joint name="wrist_flex" value="0"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <group_state name="home" group="arm">
        <joint name="elbow_flex" value="1.57"/>
        <joint name="shoulder_lift" value="-1.57"/>
        <joint name="shoulder_pan" value="0"/>
        <joint name="wrist_flex" value="0.8"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <group_state name="initial" group="arm">
        <joint name="elbow_flex" value="0"/>
        <joint name="shoulder_lift" value="0"/>
        <joint name="shoulder_pan" value="0"/>
        <joint name="wrist_flex" value="1.57"/>
        <joint name="wrist_roll" value="0"/>
    </group_state>
    <group_state name="open" group="hand">
        <joint name="gripper" value="1"/>
    </group_state>
    <group_state name="close" group="hand">
        <joint name="gripper" value="0"/>
    </group_state>
    <end_effector name="ee" parent_link="gripper_link" group="hand" parent_group="arm"/>
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="lower_arm_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="moving_jaw_so101_v1_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_link" link2="wrist_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="upper_arm_link" reason="Never"/>
    <disable_collisions link1="gripper_link" link2="elbow_flex" reason="Never"/>
    <disable_collisions link1="lower_arm_link" link2="moving_jaw_so101_v1_link" reason="Never"/>
    <disable_collisions link1="lower_arm_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="lower_arm_link" link2="wrist_link" reason="Adjacent"/>
    <disable_collisions link1="moving_jaw_so101_v1_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="lower_arm_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="gripper_frame_link" reason="Never"/>
</robot>
